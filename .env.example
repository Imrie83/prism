# Copy to .env and adjust if needed.
# Ollama runs on the host — docker-compose defaults to host.docker.internal:11434
# Override here if your Ollama runs on a different port or host.
OLLAMA_BASE_URL=http://host.docker.internal:11434

OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# MongoDB — set automatically by docker-compose to mongodb://mongo:27017
# Only override if using an external MongoDB instance
MONGO_URL=mongodb://mongo:27017

# Used for email sending and bounce monitoring
GMAIL_ADDRESS=your.email@gmail.com
GMAIL_APP_PASSWORD=your_app_password

# IMAP bounce monitoring
# EMAIL_BOUNCE_SENDER matches the From header of bounce messages
# ProtonMail uses "MAILER-DAEMON" (uppercase) — adjust if using Gmail/other
EMAIL_BOUNCE_SENDER=MAILER-DAEMON
# Folder to move processed bounce messages into (must already exist in your mailbox)
EMAIL_BOUNCE_FOLDER=Mail Delivery Fail

# How often to check inbox for bounces (in minutes)
BOUNCE_CHECK_INTERVAL_MINUTES=10
